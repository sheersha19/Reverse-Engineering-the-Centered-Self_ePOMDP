def select_configuration():
    """Let user choose a grid configuration"""
    print("Available grid configurations:")
    for i, name in enumerate(GRID_CONFIGS.keys(), 1):
        print(f"{i}. {name}")
    
    choice = int(input("\nSelect configuration (number): "))
